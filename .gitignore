# ==============================================================================
# 숨김 폴더 제외 (.github 폴더만 예외)
# ==============================================================================
.*/
!.github/
!.github/**

# ==============================================================================
# 문서 및 기획서 (버전 관리 제외)
# ==============================================================================
docs/*
!docs/superpowers/

# ==============================================================================
# Python & Bytecode Cache
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# Virtual Environments (uv, venv, conda)
# ==============================================================================
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Data Files (Keep directory structure with .gitkeep)
# 대용량 원본 데이터 및 SQLite DB는 Git 제외, 배포용 Parquet 스냅샷만 허용
# ==============================================================================
data/raw/*
!data/raw/.gitkeep
!data/raw/sgg_codes.json

data/processed/*
!data/processed/.gitkeep
!data/processed/recent_trades.parquet

# 대용량/임시 데이터 포맷
*.csv
*.tsv
*.sqlite
*.sqlite3
*.db
*.parquet
!data/processed/recent_trades.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# ==============================================================================
# Environment Variables & Secrets (보안 및 인증 정보)
# ==============================================================================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
secrets.json
credentials.json
api_key*.txt

# ==============================================================================
# Jupyter Notebook & Caches
# ==============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# ==============================================================================
# Logs & Temporary Files
# ==============================================================================
*.log
logs/
temp/
tmp/

# ==============================================================================
# Operating System & IDE Configurations
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code & JetBrains
.vscode/*
.idea/
*.sublime-project
*.sublime-workspace
