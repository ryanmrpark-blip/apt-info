# ==============================================================================
# Data Files (Keep directory structure with .gitkeep)
# 대용량 및 원본/가공 데이터셋은 Git 추적에서 제외
# ==============================================================================
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# 대용량/임시 데이터 포맷
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.sqlite
*.sqlite3
*.db

# ==============================================================================
# Environment Variables & Secrets (보안 및 인증 정보)
# ==============================================================================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
secrets.json
credentials.json
api_key*.txt

# ==============================================================================
